DEFAULT_LANG=kk
TELEGRAM_API_BASE=https://api.telegram.org/bot

# CDK deploy-time SQS retention, in days. SQS allows 1-14 day retention.
MAIN_TASK_QUEUE_RETENTION_DAYS=1
MAIN_TASK_DLQ_RETENTION_DAYS=14
VECTOR_MEMORY_QUEUE_RETENTION_DAYS=4
VECTOR_MEMORY_DLQ_RETENTION_DAYS=14

GEMINI_MODEL=gemini-3.1-flash-lite
NEWS_GEMINI_MODEL=gemini-3.1-flash-lite
QUIZ_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE=https://api.groq.com/openai/v1
SPAM_RULE_ENFORCE_THRESHOLD=0.8
SPAM_RULE_AI_THRESHOLD=0.15
SPAM_AI_CONFIDENCE_THRESHOLD=0.85
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Group memory / agent MVP
# Telegram BotFather privacy mode must be disabled (or bot made admin) for full group context.
GROUP_MEMORY_ENABLED=true
GROUP_MEMORY_RECENT_LIMIT=300
GROUP_MEMORY_RETENTION_DAYS=3650
GROUP_MEMORY_EXTRACTOR_PROVIDER=gemini
GROUP_MEMORY_EXTRACTOR_MODE=gemini_candidate_only
GROUP_MEMORY_EXTRACTOR_MIN_CONFIDENCE=0.65
GROUP_MEMORY_EXTRACTOR_DAILY_LLM_LIMIT=50
GROUP_MEMORY_EXTRACTOR_PER_CHAT_DAILY_LIMIT=20
GROUP_MEMORY_DAILY_SUMMARY_DAYS=7
GROUP_MEMORY_DAILY_SUMMARY_MESSAGE_LIMIT=500
VECTOR_MEMORY_ENABLED=true
VECTOR_MEMORY_PROVIDER=s3_vectors
VECTOR_MEMORY_DIMENSIONS=768
VECTOR_MEMORY_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_RPD_LIMIT=1000
VECTOR_MEMORY_INDEX_THROTTLE_SECONDS=3
VECTOR_MEMORY_BACKFILL_BATCH_SIZE=50
VECTOR_MEMORY_MAX_DISTANCE=0.85
# Leave empty to use CDK's default names:
# zerde-serverless-memory-vectors-<env> / zerde-serverless-group-memory-<env>
VECTOR_MEMORY_VECTOR_BUCKET_NAME=
VECTOR_MEMORY_INDEX_NAME=
AGENT_ENABLED=true
AGENT_BOT_USERNAME=@zerde_kz_bot
AGENT_RECENT_CONTEXT_LIMIT=100
AGENT_DAILY_PROACTIVE_LIMIT=3
AGENT_PROACTIVE_SCORE_THRESHOLD=0.62
AGENT_PROACTIVE_FINAL_THRESHOLD=0.72

CHATS_KK="-1234567890"
CHATS_ZH="-1234567890"
CHATS_RU="-1234567890"
NEWS_CHATS_KK=
NEWS_CHATS_ZH=
NEWS_CHATS_RU=
QUIZ_CHATS_KK=
QUIZ_CHATS_ZH=
QUIZ_CHATS_RU=

BOT_TOKEN=<your_bot_token>
WEBHOOK_SECRET_TOKEN=<your_webhook_secret_token>

GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_EMBEDDING_API_KEY=
GROQ_API_KEY=<your_groq_api_key>
DEEPSEEK_API_KEY=<your_deepseek_api_key>

ADMIN_USER_ID=<your_admin_user_id>
