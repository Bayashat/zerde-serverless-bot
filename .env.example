DEV_RUNTIME_ENABLED=false
# Dev is idle by default; drain time-sensitive work before disabling it.
DEFAULT_LANG=kk
TELEGRAM_API_BASE=https://api.telegram.org/bot
CAPTCHA_TIMEOUT_SECONDS=120
KICK_BAN_DURATION_SECONDS=60
CAPTCHA_MAX_ATTEMPTS=3
VOTEBAN_THRESHOLD=7
VOTEBAN_FORGIVE_THRESHOLD=7
GEMINI_RPD_LIMIT=500
QUIZ_LLM_RPD=20
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/models

# CDK deploy-time SQS retention, in days. SQS allows 1-14 day retention.
MAIN_TASK_QUEUE_RETENTION_DAYS=1
MAIN_TASK_DLQ_RETENTION_DAYS=14

GEMINI_MODEL=gemini-3.1-flash-lite
NEWS_GEMINI_MODEL=gemini-3.1-flash-lite
QUIZ_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SPAM_MODEL=openai/gpt-oss-safeguard-20b
GROQ_API_BASE=https://api.groq.com/openai/v1
SPAM_RULE_ENFORCE_THRESHOLD=0.8
SPAM_RULE_AI_THRESHOLD=0.15
SPAM_AI_CONFIDENCE_THRESHOLD=0.85
# JSON object mapping chat_id to Telegram usernames to @mention on uncertain spam review alerts.
# Example: {"-1001244628965":["bayashat","yeskabyl"]}
SPAM_REVIEW_ADMIN_MENTIONS={}
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Explicit bot identity (not a learning or proactive switch).
AGENT_BOT_USERNAME=@zerde_kz_bot
AGENT_BOT_ID=
MULTIMODAL_ENABLED=true
MULTIMODAL_MAX_DOWNLOAD_BYTES=12000000
MULTIMODAL_INLINE_MAX_BYTES=8000000
MULTIMODAL_TEXT_FILE_MAX_CHARS=20000

CHATS_KK="-1234567890"
CHATS_ZH="-1234567890"
CHATS_RU="-1234567890"
NEWS_CHATS_KK=
NEWS_CHATS_ZH=
NEWS_CHATS_RU=
QUIZ_CHATS_KK=
QUIZ_CHATS_ZH=
QUIZ_CHATS_RU=

BOT_TOKEN=<your_bot_token>
WEBHOOK_SECRET_TOKEN=<your_webhook_secret_token>

GEMINI_API_KEY=<your_gemini_api_key>
GROQ_API_KEY=<your_groq_api_key>
DEEPSEEK_API_KEY=<your_deepseek_api_key>

ADMIN_USER_ID=<your_admin_user_id>

# Runtime-only: CDK injects the independent V2 table name. Leave empty for local no-memory mode.
# This is not an Actions deployment variable and does not enable learning.
MEMORY_V2_TABLE_NAME=

# Set once to the approved first V2 rollout UTC timestamp, identically in dev/prod.
# 0 keeps optional V2 work paused and the hourly cost monitor disabled before cutover.
# Never move a positive timestamp forward to discard usage history.
MEMORY_COST_METERING_STARTED_AT=0
