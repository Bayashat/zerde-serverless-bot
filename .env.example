DEFAULT_LANG=kk
TELEGRAM_API_BASE=https://api.telegram.org/bot

AI_PROVIDER=gemini
WTF_GEMINI_MODEL=gemini-3.1-flash-lite
NEWS_GEMINI_MODEL=gemini-3.1-flash-lite
QUIZ_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
SPAM_RULE_ENFORCE_THRESHOLD=0.8
SPAM_RULE_AI_THRESHOLD=0.15
SPAM_AI_CONFIDENCE_THRESHOLD=0.85
WTF_FALLBACK_PROVIDER=deepseek  # deepseek | llama (Groq is not wired to /wtf in the bot)
DEEPSEEK_MODEL=deepseek-v4-flash

CHATS_KK="-1234567890"
CHATS_ZH="-1234567890"
CHATS_RU="-1234567890"

BOT_TOKEN=<your_bot_token>
WEBHOOK_SECRET_TOKEN=<your_webhook_secret_token>

GEMINI_API_KEY=<your_gemini_api_key>
GROQ_API_KEY=<your_groq_api_key>
DEEPSEEK_API_KEY=<your_deepseek_api_key>

ADMIN_USER_ID=<your_admin_user_id>
