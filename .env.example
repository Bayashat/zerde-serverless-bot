DEFAULT_LANG=kk
TELEGRAM_API_BASE=https://api.telegram.org/bot

AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
NEWS_GEMINI_MODEL=gemini-3.1-flash-lite
QUIZ_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
SPAM_RULE_ENFORCE_THRESHOLD=0.8
SPAM_RULE_AI_THRESHOLD=0.15
SPAM_AI_CONFIDENCE_THRESHOLD=0.85
DEEPSEEK_MODEL=deepseek-v4-flash

# Group memory / agent MVP
# Telegram BotFather privacy mode must be disabled (or bot made admin) for full group context.
GROUP_MEMORY_ENABLED=true
GROUP_MEMORY_RECENT_LIMIT=300
GROUP_MEMORY_RETENTION_DAYS=30
GROUP_MEMORY_DAILY_SUMMARY_DAYS=7
GROUP_MEMORY_DAILY_SUMMARY_MESSAGE_LIMIT=500
VECTOR_MEMORY_ENABLED=false
VECTOR_MEMORY_PROVIDER=s3_vectors
VECTOR_MEMORY_DIMENSIONS=768
VECTOR_MEMORY_EMBEDDING_MODEL=gemini-embedding-001
AGENT_ENABLED=true
AGENT_BOT_USERNAME=@zerde_kz_bot
AGENT_RECENT_CONTEXT_LIMIT=100
AGENT_DAILY_PROACTIVE_LIMIT=10
AGENT_PROACTIVE_SCORE_THRESHOLD=0.62
AGENT_PROACTIVE_FINAL_THRESHOLD=0.72

CHATS_KK="-1234567890"
CHATS_ZH="-1234567890"
CHATS_RU="-1234567890"

BOT_TOKEN=<your_bot_token>
WEBHOOK_SECRET_TOKEN=<your_webhook_secret_token>

GEMINI_API_KEY=<your_gemini_api_key>
GROQ_API_KEY=<your_groq_api_key>
DEEPSEEK_API_KEY=<your_deepseek_api_key>

ADMIN_USER_ID=<your_admin_user_id>
